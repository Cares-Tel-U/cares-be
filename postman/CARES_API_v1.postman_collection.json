              "raw": "{\n  \"judul\": \"AC Bocor dan Mengeluarkan Udara Panas\",\n  \"deskripsi\": \"Unit AC di ruangan TULT-08-01 meneteskan air ke meja mahasiswa dan suhu udara tetap panas selama perkuliahan berlangsung.\",\n  \"facilityId\": \"{{facilityId}}\",\n  \"isAnonymous\": false,\n  \"photos\": [\n    \"/uploads/ac_bocor_dummy.jpg\"\n  ]\n}"
