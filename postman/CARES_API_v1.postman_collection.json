        {
          "name": "Uji Deteksi Duplikasi Laporan Fasilitas Aktif (TC11)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Pesan error laporan aktif terdeteksi', function () {",
                  "    pm.expect(res.status).to.eql('error');",
                  "    pm.expect(res.message).to.include('sedang dalam penanganan');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMahasiswa}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
