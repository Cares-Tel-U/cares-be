        {
          "name": "Get All Facilities Master Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.environment.set('facilityId', res.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facilities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "facilities"
              ]
            },
            "description": "Mengambil seluruh master data fasilitas kampus (Gedung, Ruangan, Toilet, Lab, Parkiran) untuk formulir pelaporan."
          }
        },
        {
          "name": "Tambah Master Fasilitas Baru (Admin / Sarpras)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Response status success', function () {",
                  "    pm.expect(res.status).to.eql('success');",
                  "});",
                  "if (res.data && res.data.id) {",
                  "    pm.environment.set('facilityId', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"TULT-09-05 (Laboratorium Rekayasa Jaringan)\",\n  \"lokasi\": \"Gedung TULT\",\n  \"kategori\": \"LABORATORIUM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/facilities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "facilities"
              ]
            },
            "description": "Menambahkan data master fasilitas/ruangan kampus baru oleh petugas Sarpras/Admin."
          }
        }
      ]
