    {
      "name": "4. Reports (Pelapor)",
      "item": [
        {
          "name": "Lihat Seluruh Laporan Publik Kampus (Feed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMahasiswa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports?page=1&per_page=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "PENDING",
                  "disabled": true
                }
              ]
            },
            "description": "Mengambil seluruh daftar laporan publik di kampus dengan perlindungan privasi laporan anonim."
          }
        },
        {
          "name": "Buat Laporan Kerusakan Baru (JSON Dummy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
