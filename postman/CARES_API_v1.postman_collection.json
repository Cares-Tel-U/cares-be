            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "description": "Membuat tiket laporan kerusakan baru dengan data JSON dan foto URL dummy."
