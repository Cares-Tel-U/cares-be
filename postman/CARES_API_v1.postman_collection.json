    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Akun Mahasiswa Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Mahasiswa Tester Dummy\",\n  \"email\": \"mhs.tester@telkomuniversity.ac.id\",\n  \"password\": \"password123\",\n  \"role\": \"MAHASISWA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan akun civitas akademika baru ke dalam sistem."
          }
        },
        {
          "name": "Register Akun Petugas Sarpras Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Sarpras Tester Dummy\",\n  \"email\": \"sarpras.tester@telkomuniversity.ac.id\",\n  \"password\": \"admin123\",\n  \"role\": \"SARPRAS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan akun admin/petugas sarpras baru."
          }
        },
        {
          "name": "Login Mahasiswa (Simpan Token Otomatis)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set('tokenMahasiswa', res.data.token);",
                  "    pm.environment.set('authToken', res.data.token);",
                  "    console.log('Token Mahasiswa berhasil disimpan ke environment.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailMahasiswa}}\",\n  \"password\": \"{{passwordMahasiswa}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login sebagai Mahasiswa (Amba Ngawi). Token JWT otomatis tersimpan ke variabel environment {{tokenMahasiswa}} dan {{authToken}}."
          }
        },
        {
          "name": "Login Admin / Sarpras (Simpan Token Otomatis)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set('tokenAdmin', res.data.token);",
                  "    pm.environment.set('authToken', res.data.token);",
                  "    console.log('Token Admin berhasil disimpan ke environment.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login sebagai Admin Sarpras. Token JWT otomatis tersimpan ke variabel environment {{tokenAdmin}}."
          }
        },
        {
          "name": "Lupa Password (Request Reset Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pengguna1@telkomuniversity.ac.id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Mengajukan reset kata sandi dan menghasilkan token pemulihan."
          }
        },
        {
          "name": "Reset Password Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"MASUKKAN_RESET_TOKEN_DARI_FORGOT_PASSWORD\",\n  \"newPassword\": \"passwordBaru123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Mereset kata sandi akun menggunakan token pemulihan yang diperoleh dari forgot-password."
          }
        },
        {
          "name": "Cek Ketersediaan Email Terdaftar (/auth/check-email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pengguna1@telkomuniversity.ac.id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/check-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "check-email"
              ]
            },
            "description": "Memvalidasi apakah email civitas terdaftar sebelum mengirim instruksi reset kata sandi."
          },
          "response": [
            {
              "name": "200 OK - Email Terdaftar",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/auth/check-email",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "check-email"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Alamat email terdaftar dalam sistem.\",\n  \"data\": {\n    \"exists\": true,\n    \"email\": \"pengguna1@telkomuniversity.ac.id\",\n    \"nama\": \"Pengguna Satu\"\n  }\n}"
            },
            {
              "name": "404 Not Found - Email Tidak Terdaftar",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/auth/check-email",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "check-email"
                  ]
                }
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Alamat email tidak terdaftar dalam sistem CARES.\",\n  \"data\": {\n    \"exists\": false\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Get Current User Profile (/users/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Mengambil data profil pengguna yang sedang login berdasarkan Bearer token."
          }
        },
        {
          "name": "Perbarui Foto Profil Avatar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMahasiswa}}"
