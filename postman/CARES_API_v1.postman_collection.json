            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatarUrl\": \"/uploads/avatars/bintang_avatar.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "avatar"
              ]
            },
            "description": "Memperbarui foto profil akun pengguna (mendukung link URL atau form upload avatar)."
          }
        },
        {
          "name": "Ubah Preferensi Notifikasi",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMahasiswa}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/notification-preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "notification-preferences"
              ]
            },
            "description": "Mengatur status preferensi notifikasi akun pengguna (aktif/nonaktif)."
          }
        },
        {
          "name": "Unggah Berkas Avatar (Multipart / Form-Data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 400', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMahasiswa}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "description": "Pilih berkas gambar avatar (JPEG, PNG, WEBP maks 5MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "avatar"
              ]
            },
            "description": "Memperbarui foto profil avatar pengguna secara langsung melalui unggahan file biner (multipart/form-data)."
          }
        }
      ]
    },
    {
      "name": "3. Facilities",
